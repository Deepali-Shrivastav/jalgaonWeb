# =========================================================================
# Git Ignore Configuration for JalgaonWeb Project
# =========================================================================

# Django Environment
/jalgaonApi/.env
/jalgaonApi/.env.development
/jalgaonApi/.env.production
db.sqlite3
db_old.sqlite3
*.log
local_settings.py

# React Environment (jalgaonUi)
/jalgaonUi/.env
/jalgaonUi/.env.local
!/jalgaonUi/.env.development
!/jalgaonUi/.env.production

# React Environment (New-JalgaonUI)
# NOTE: .env.production is also ignored here because it contains secret API keys
# (COMMODITY_PRICE_API_KEY, WEATHERAPI_KEY). The CI/CD workflow writes it
# directly to the server at deploy time — never commit this file.
/New-JalgaonUI/.env
/New-JalgaonUI/.env.local
/New-JalgaonUI/.env.*.local
/New-JalgaonUI/.env.production
/New-JalgaonUI/.next/
/New-JalgaonUI/out/
/New-JalgaonUI/build/

# Python Virtual Environments
.venv/
venv/
ENV/
env/

# Python caching
**/__pycache__/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
.env
venv/
.venv
env/
node_modules/
dist/
.DS_Store1
