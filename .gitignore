# =========================================================================
# Git Ignore Configuration for JalgaonWeb Project
# =========================================================================

# Django Environment
/jalgaonApi/.env
/jalgaonApi/.env.development
/jalgaonApi/.env.production
db.sqlite3
db_old.sqlite3
*.log
local_settings.py

# React Environment (jalgaonUi)
/jalgaonUi/.env
/jalgaonUi/.env.local
!/jalgaonUi/.env.development
!/jalgaonUi/.env.production

# React Environment (New-JalgaonUI)
# NOTE: .env.production is also ignored here because it contains secret API keys
# (COMMODITY_PRICE_API_KEY, WEATHERAPI_KEY). The CI/CD workflow writes it
# directly to the server at deploy time — never commit this file.
/New-JalgaonUI/.env
/New-JalgaonUI/.env.local
/New-JalgaonUI/.env.*.local
/New-JalgaonUI/.env.production
/New-JalgaonUI/.next/
/New-JalgaonUI/out/
/New-JalgaonUI/build/
/New-JalgaonUI/public/images/
/New-JalgaonUI/public/*.svg
/New-JalgaonUI/public/*.png
/New-JalgaonUI/public/*.jpg
/New-JalgaonUI/public/*.jpeg
/New-JalgaonUI/public/*.ico



# Python Virtual Environments
.venv/
venv/
ENV/
env/

# Python caching
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Django static/media files
staticfiles/
media/

# Node.js
node_modules/
dist/
.eslintcache

# OS Files
.DS_Store
Thumbs.db

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# Legacy Media Uploads (from models)
jalgaonApi/static/assets/article_imgs/
jalgaonApi/static/assets/categories/

# One-off Utility Scripts
jalgaonApi/create_apps.py
jalgaonApi/fake_mig.py
jalgaonApi/data.json
