[Unit]
Description=Next.js Frontend — Jalgaon.com (New-JalgaonUI)
Documentation=https://nextjs.org/docs/app/building-your-application/deploying
After=network.target

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/jalgaonWeb/New-JalgaonUI

# Load production environment variables.
# This file contains both public and SECRET vars (API keys for market/weather).
# Written by the CI/CD deploy workflow — never committed to git.
EnvironmentFile=/home/ubuntu/jalgaonWeb/New-JalgaonUI/.env.production

# Run Next.js production server on port 3000.
# Uses the local node_modules/.bin/next to ensure correct version.
ExecStart=/usr/bin/env node_modules/.bin/next start -p 3000

# Restart policy — restart on any failure, wait 10s between attempts.
# This covers crashes, OOM kills, and build-related restarts.
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nextjs_jalgaon

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
